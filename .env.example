# AssemblyAI API key (free credits via lablab signup link)
ASSEMBLYAI_API_KEY=

# LLM Gateway model (via AssemblyAI)
LLM_MODEL=qwen3.5-4b-32k-fast

# TTS provider (azure / elevenlabs / assemblyai-voice)
TTS_PROVIDER=azure
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastus

# Backend storage backend: sqlite | dynamodb
STORAGE_BACKEND=sqlite
# AWS (for DynamoDB/S3 in prod)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
DYNAMO_TABLE=voicekb
S3_BUCKET=voicekb-assets

# FastAPI host/port
HOST=0.0.0.0
PORT=8000
